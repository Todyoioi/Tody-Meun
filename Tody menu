local function alternarMenu()
    if menuPrincipal.Visible == false then
        menuPrincipal.Visible = true
        menuPrincipal.Size = UDim2.new(0, 420, 0, 0)
        TweenService:Create(menuPrincipal, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Size = UDim2.new(0, 420, 0, 220)}):Play()
    else
        TweenService:Create(menuPrincipal, TweenInfo.new(0.2), {Size = UDim2.new(0, 420, 0, 0)}):Play()
        task.wait(0.2)
        menuPrincipal.Visible = false
        menuPrincipal.Size = UDim2.new(0, 420, 0, 220)
    end
end

