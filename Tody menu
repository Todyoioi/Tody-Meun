local function alternarMenu()
    if fundo.Visible == false then
        fundo.Visible = true
        fundo.Size = UDim2.new(0, 280, 0, 0)
        TweenService:Create(fundo, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Size = UDim2.new(0, 280, 0, 240)}):Play()
    else
        TweenService:Create(fundo, TweenInfo.new(0.2), {Size = UDim2.new(0, 280, 0, 0)}):Play()
        task.wait(0.2)
        fundo.Visible = false
        fundo.Size = UDim2.new(0, 280, 0, 240)
    end
end

