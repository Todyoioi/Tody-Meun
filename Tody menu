--==================== FUNÇÕES DO JOGO ====================
local function getAlvos()
	local lista = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			table.insert(lista, p.Character)
		end
	end
	for _, obj in pairs(workspace:GetChildren()) do
		if obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") and obj ~= LocalPlayer.Character then
			if not Players:GetPlayerFromCharacter(obj) then
				table.insert(lista, obj)
			end
		end
	end
	return lista
end

--==================== ESP ====================
local function getCorTime(char)
	local playerDesseChar = Players:GetPlayerFromCharacter(char)
	if not playerDesseChar then return Color3.fromRGB(255, 50, 50) end
	if LocalPlayer.Team and playerDesseChar.Team and LocalPlayer.Team == playerDesseChar.Team then
		return Color3.fromRGB(255, 255, 255)
	end
	return Color3.fromRGB(255, 50, 50)
end

local function criarESP(char)
	if char == LocalPlayer.Character or highlights[char] then return end
	local head = char:FindFirstChild("Head")
	if not head then return end

	local corESP = getCorTime(char)

	local hl = Instance.new("Highlight")
	hl.FillColor = corESP
	hl.OutlineColor = corESP
	hl.FillTransparency = 0.6
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = char
	hl.Parent = char

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 150, 0, 40)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = head
	bb.Parent = head
	bb.Enabled = mostrarNome

	local nomeLabel = Instance.new("TextLabel")
	nomeLabel.Size = UDim2.new(1, 0, 0, 20)
	nomeLabel.Position = UDim2.new(0, 0, 0, 0)
	nomeLabel.BackgroundTransparency = 1
	nomeLabel.TextColor3 = corESP 
	nomeLabel.TextStrokeTransparency = 0
	nomeLabel.TextScaled = true
	nomeLabel.Font = Enum.Font.GothamBlack
	nomeLabel.Text = char.Name
	nomeLabel.Parent = bb

	local distLabel = Instance.new("TextLabel")
	distLabel.Size = UDim2.new(1, 0, 0, 15)
	distLabel.Position = UDim2.new(0, 0, 0, 20)
	distLabel.BackgroundTransparency = 1
	distLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	distLabel.TextStrokeTransparency = 0
	distLabel.TextScaled = true
	distLabel.Font = Enum.Font.GothamMedium
	distLabel.Text = "[0m]"
	distLabel.Parent = bb

	highlights[char] = { hl = hl, bb = bb, nomeLabel = nomeLabel, distLabel = distLabel }
end

local function limparESP()
	for char, d in pairs(highlights) do
		if d.hl then d.hl:Destroy() end
		if d.bb then d.bb:Destroy() end
	end
	highlights = {}
end

local function gerenciarESP()
	if not espAtivo then return end
	for char, d in pairs(highlights) do
		if not char or not char.Parent or not char:FindFirstChild("Head") then
			if d.hl then d.hl:Destroy() end
			if d.bb then d.bb:Destroy() end
			highlights[char] = nil
		end
	end
	for _, char in pairs(getAlvos()) do
		if not highlights[char] then criarESP(char) end
	end
end

local function atualizarESP()
	for char, d in pairs(highlights) do
		if char.Parent and d.nomeLabel then
			local head = char:FindFirstChild("Head")
			if head then
				local dist = (head.Position - Camera.CFrame.Position).Magnitude
				d.distLabel.Text = "[" .. math.floor(dist) .. "m]"
			end
		end
	end
end

--==================== AIMBOT ====================
local function acharAlvo()
	local melhor, melhorScore = nil, math.huge
	local origem = Camera.CFrame.Position
	local olhar = Camera.CFrame.LookVector

	for _, char in pairs(getAlvos()) do
		local head = char:FindFirstChild("Head")
		if head then
			local dir = head.Position - origem
			local dist = dir.Magnitude
			if dist < 500 then
				local ang = math.deg(math.acos(math.clamp(olhar.Unit:Dot(dir.Unit), -1, 1)))
				if ang < 180 then
					local score = ang + dist * 0.05
					if score < melhorScore then
						melhorScore = score
						melhor = head.Position
					end
				end
			end
		end
	end
	return melhor
end

local function atualizarAimbot(dt)
	if not aimbotAtivo then return end
	local alvo = acharAlvo()
	if not alvo then return end
	local alvoCF = CFrame.lookAt(Camera.CFrame.Position, alvo)
	Camera.CFrame = Camera.CFrame:Lerp(alvoCF, math.clamp(0.5 * dt * 60, 0, 1))
end

