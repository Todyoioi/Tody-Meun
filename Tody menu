-- ==================== EFEITO DE ABRIR/FECHAR ====================
local function alternarMenu()
	if menuPrincipal.Visible == false then
		-- Efeito ao ABRIR
		menuPrincipal.Visible = true
		menuPrincipal.Size = UDim2.new(0, 0, 0, 0)
		
		TweenService:Create(menuPrincipal, TweenInfo.new(
			0.4, 
			Enum.EasingStyle.Back, 
			Enum.EasingDirection.Out
		), {
			Size = UDim2.new(0, 420, 0, 240)
		}):Play()
	else
		-- Efeito ao FECHAR
		TweenService:Create(menuPrincipal, TweenInfo.new(
			0.25, 
			Enum.EasingStyle.Quad, 
			Enum.EasingDirection.In
		), {
			Size = UDim2.new(0, 0, 0, 0)
		}):Play()
		
		task.wait(0.25)
		menuPrincipal.Visible = false
		menuPrincipal.Size = UDim2.new(0, 420, 0, 240)
	end
end

botaoT.MouseButton1Click:Connect(alternarMenu)

UserInputService.InputBegan:Connect(function(input, processado)
	if processado then return end
	if input.KeyCode == Enum.KeyCode.G then
		alternarMenu()
	end
end)

