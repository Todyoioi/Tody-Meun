-- BOTÃO DE CATEGORIA NA ESQUERDA
local botoesAba = {}
local function criarAba(texto, yPos, nomePagina)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    btn.TextColor3 = Color3.fromRGB(150, 150, 170)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.Text = texto
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = barraEsquerda

    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = btn
    botoesAba[nomePagina] = btn

    btn.MouseButton1Click:Connect(function()
        for pNome, pFrame in pairs(paginas) do
            pFrame.Visible = false
            botoesAba[pNome].BackgroundColor3 = Color3.fromRGB(20, 20, 28)
            botoesAba[pNome].TextColor3 = Color3.fromRGB(150, 150, 170)
        end
        paginas[nomePagina].Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
end

-- Função auxiliar para criar botões de toggle
local function criarBotaoToggle(pagina, texto, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.Position = UDim2.new(0, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.TextColor3 = Color3.fromRGB(200, 200, 220)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.Text = texto
    btn.AutoButtonColor = false
    btn.Parent = pagina

    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
    local stroke = Instance.new("UIStroke"); stroke.Color = Color3.fromRGB(60, 60, 80); stroke.Thickness = 1; stroke.Parent = btn

    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(45, 45, 60)}):Play() end)
    btn.MouseLeave:Connect(function() if not btn:GetAttribute("Ativo") then TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 30, 40)}):Play() end end)
    btn.MouseButton1Click:Connect(function() callback(btn, stroke) end)
    return btn
end

